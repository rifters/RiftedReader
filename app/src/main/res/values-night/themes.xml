<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Dark / Night) -->
    <style name="Base.Theme.RiftedReader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_dark_mode</item>
        <item name="colorOnPrimary">#381E72</item>
        <item name="colorPrimaryDark">#381E72</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/primary_light</item>
        
        <item name="colorSecondary">@color/secondary_dark_mode</item>
        <item name="colorOnSecondary">#332D41</item>
        <item name="colorSecondaryContainer">@color/secondary_dark</item>
        <item name="colorOnSecondaryContainer">@color/secondary_light</item>
        
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
        <item name="colorSurfaceContainer">@color/surface_container_dark</item>
        
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary_dark</item>
        <item name="android:textColorSecondary">@color/text_secondary_dark</item>
        
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <!-- Preference Theme -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        
        <!-- Component styles -->
        <item name="toolbarStyle">@style/Widget.RiftedReader.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.RiftedReader.BottomNavigationView</item>
    </style>

    <style name="Theme.RiftedReader" parent="Base.Theme.RiftedReader" />

    <style name="Widget.RiftedReader.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/toolbar_text</item>
        <item name="subtitleTextColor">#CAC4D0</item>
        <item name="navigationIconTint">@color/toolbar_text</item>
    </style>

    <style name="Widget.RiftedReader.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_tint</item>
        <item name="itemTextColor">@color/bottom_nav_item_tint</item>
        <item name="android:background">@color/app_surface</item>
    </style>

    <style name="TextAppearance.RiftedReader.BottomSheetTitle" parent="TextAppearance.Material3.TitleLarge" />
    
    <!-- Reader theme (Dark) -->
    <style name="Theme.RiftedReader.Reader" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/reader_background_dark</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
